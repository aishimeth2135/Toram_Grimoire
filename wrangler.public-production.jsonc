{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toram-grimoire-public-production",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cy-grimoire.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
